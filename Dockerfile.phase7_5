# syntax=docker/dockerfile:1
# Cloud Run Jobs Dockerfile for Phase 7.5 Dedicated Prompt Injection Benchmark (CloneGuard)

FROM ghcr.io/astral-sh/uv:0.6.14 AS uv_bin
FROM python:3.12-slim

COPY --from=uv_bin /uv /uvx /bin/
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"
ENV USE_VERTEX_AI=true
ENV GCP_PROJECT_ID=dependency-impact-analyzer
ENV GCP_REGION=asia-south1
ENV VERTEX_AI_LOCATION=global
ENV VERTEX_AI_MODEL=gemini-3.1-flash-lite
ENV VERTEX_AI_FALLBACK_MODEL=gemini-2.5-flash
ENV ENABLE_MODEL_ARMOR=true
ENV MODEL_ARMOR_LOCATION=asia-south1
ENV MODEL_ARMOR_TEMPLATE_ID=pr-security-shield
ENV MODEL_ARMOR_SCAN_MODEL_RESPONSE=true
ENV MODEL_ARMOR_FAIL_CLOSED=true
ENV MODEL_ARMOR_ENABLE_MULTILANG=true
ENV MODEL_ARMOR_REQUEST_DELAY_MS=350
ENV LLM_REQUEST_DELAY_MS=350
ENV CLONEGUARD_DATASET_DIR=/app/data/cloneguard
ENV BENCHMARK_GCS_PREFIX=benchmarks/phase7_5
ENV BENCHMARK_FIRESTORE_COLLECTION=phase7_5_injection_runs

COPY pyproject.toml uv.lock README.md /app/
RUN uv sync --frozen --no-install-project --no-dev

# Bake the public Apache-2.0 prodnull/cloneguard benchmark JSON corpus into the image (with JSON validation)
RUN mkdir -p /app/data/cloneguard && /app/.venv/bin/python -c "\
import httpx, json, pathlib; \
base='https://raw.githubusercontent.com/prodnull/cloneguard/main/data/benchmark'; \
files=['malicious_corpus.json','benign_corpus_eval.json','benign_longform_real.json','defensive_security_corpus.json']; \
out=pathlib.Path('/app/data/cloneguard'); \
[(r := httpx.get(f'{base}/{f}', follow_redirects=True, timeout=30), r.raise_for_status(), json.loads(r.text), out.joinpath(f).write_text(r.text, encoding='utf-8')) for f in files]"

COPY src /app/src
COPY benchmark/phase7_5_harness.py /app/benchmark/phase7_5_harness.py

RUN uv sync --frozen --no-dev

ENTRYPOINT ["python", "benchmark/phase7_5_harness.py"]
CMD ["--concurrency", "2", "--request-delay-ms", "350", "--wait-for-shards-seconds", "600"]

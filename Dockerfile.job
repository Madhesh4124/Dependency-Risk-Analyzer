# syntax=docker/dockerfile:1
# Cloud Run Jobs Dockerfile for Phase 7 Parallel Benchmark Evaluation
# Uses astral-sh/uv for fast dependency caching

FROM ghcr.io/astral-sh/uv:0.6.14 AS uv_bin
FROM python:3.12-slim

COPY --from=uv_bin /uv /uvx /bin/
WORKDIR /app

ENV UV_COMPILE_BYTECODE=1
ENV UV_LINK_MODE=copy
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:$PATH"
ENV USE_VERTEX_AI=true
ENV GCP_PROJECT_ID=dependency-impact-analyzer
ENV GCP_REGION=asia-south1
ENV VERTEX_AI_MODEL=gemini-3.1-flash-lite

# Copy package configurations
COPY pyproject.toml uv.lock README.md /app/

# Install dependencies including kagglehub
RUN uv sync --frozen --no-install-project --no-dev

# Copy application source and benchmark files
COPY src /app/src
COPY benchmark /app/benchmark

# Install project package
RUN uv sync --frozen --no-dev

# Default entrypoint for Cloud Run Jobs parallel sharding with live Gemini calls
ENTRYPOINT ["python", "benchmark/scale_harness.py"]
CMD ["--use-live-llm", "--concurrency", "4"]
